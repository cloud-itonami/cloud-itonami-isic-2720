(ns cellworks.physics-probe
  "The physical-AI bot's measurement: run this actor's REAL `physics-2d`
  UN 38.3 T6 crush-test simulation (`cellworks.robotics/simulate-crush`)
  over a fixed sweep of press-platen masses and print ONE EDN map of the
  physical quantities it computed.

    kbb -M:dev:physics

  This is what the resident bot (hermes/profiles/physai-isic-2720/SOUL.md)
  reads every tick. Every number is derived from a time-stepped trajectory
  by `cellworks.robotics`, never typed in. Output schema
  `itonami.physical-ai.probe.v1`:

    {:physics-probe/schema \"itonami.physical-ai.probe.v1\"
     :repo      \"cloud-itonami/cloud-itonami-isic-2720\"
     :procedure \"...\"
     :solver    \"physics-2d/world-step\"
     :runs      [{:input {...} :quantities {...} :out-of-tolerance? bool} ...]
     :derived   {...}           ; quantities computed ACROSS runs
     :count     n               ; runs that produced numeric quantities
     :expected  n}

  `:count` is an evidence floor: 0 means \"could not measure\", never
  \"nothing out of tolerance\". Exit 0 when every run produced numbers,
  2 when any run did not."
  (:require [cellworks.robotics :as robotics]))

(def schema "itonami.physical-ai.probe.v1")

(def sweep-platen-masses-kg
  "Press-platen masses swept each tick. 80 kg (batch-1..4) and 300 kg
  (batch-5) are the fixtures `cellworks.store` seeds; the others bracket
  them so a solver change shows up as a change in slope, not one point."
  [40 80 120 200 300])

(defn- telemetry [mass-kg]
  (robotics/crush-telemetry-for {:crush-press-platen-mass-kg mass-kg}))

(defn- run-one [mass-kg]
  (let [t (telemetry mass-kg)]
    {:input {:crush-press-platen-mass-kg mass-kg}
     :quantities (assoc t :sim-peak-decel-mps2 (/ (:sim-peak-crush-force-n t) (double mass-kg)))
     :out-of-tolerance? (robotics/crush-force-out-of-tolerance? t)}))

(defn max-passing-platen-mass-kg
  "Largest press-platen mass whose simulated peak crush force stays at or
  below UN 38.3 T6's `un383-t6-crush-force-ceiling-n`, by bisection over
  the REAL simulation (force is monotone in mass at fixed closing velocity
  and travel -- pinned by physics_probe_test). nil when the bracket does
  not straddle the ceiling."
  ([] (max-passing-platen-mass-kg 1.0 1000.0 40))
  ([lo hi iters]
   (let [over? (fn [m] (robotics/crush-force-out-of-tolerance? (telemetry m)))]
     (when (and (not (over? lo)) (over? hi))
       (loop [lo lo hi hi i 0]
         (if (>= i iters)
           lo
           (let [mid (/ (+ lo hi) 2.0)]
             (if (over? mid)
               (recur lo mid (inc i))
               (recur mid hi (inc i))))))))))

(defn probe []
  (let [runs (mapv run-one sweep-platen-masses-kg)
        numeric? (fn [r] (number? (get-in r [:quantities :sim-peak-crush-force-n])))]
    {:physics-probe/schema schema
     :repo "cloud-itonami/cloud-itonami-isic-2720"
     :procedure "UN 38.3 T6 mechanical crush test of a 21700 cylindrical Li-ion cell (robot crush-test cell)"
     :solver "physics-2d/world-step"
     :runs runs
     :derived {:un383-t6-crush-force-ceiling-n robotics/un383-t6-crush-force-ceiling-n
               :max-passing-platen-mass-kg (max-passing-platen-mass-kg)}
     :count (count (filter numeric? runs))
     :expected (count sweep-platen-masses-kg)}))

(defn -main [& _]
  (let [p (probe)]
    (prn p)
    (when-not (= (:count p) (:expected p))
      #?(:cljs (set! (.-exitCode js/process) 2)
         :default (System/exit 2)))))
